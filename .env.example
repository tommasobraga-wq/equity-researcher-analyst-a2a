# Required
ANTHROPIC_API_KEY=

# Optional — enable HMAC signing/verification of A2A requests between the
# orchestrator and the 5 agents. If unset, auth is skipped entirely (dev
# default). Set A2A_AUTH_REQUIRED=true to make a missing secret a hard
# startup failure instead of a silent skip.
A2A_SHARED_SECRET=
A2A_AUTH_REQUIRED=false

# Optional — enables audit-log persistence to Postgres. If unset, audit
# logging degrades to a no-op (a warning is printed, nothing else happens).
DATABASE_URL=

# Required for the Compliance Agent (policy RAG over pgvector + Voyage AI
# embeddings). Unlike the other optional vars above, this does NOT degrade to
# a no-op — the Compliance Agent fails to start without it, since silently
# skipping a compliance check would be dangerous. Also requires DATABASE_URL
# and a Postgres instance with the `vector` extension available.
VOYAGE_API_KEY=

# Unused by the current pipeline (RSS feeds require no key); kept for the
# planned Model phase 2 (Gemini Flash for NewsSentiment, see CLAUDE.md roadmap).
SERPER_API_KEY=
