# Required
ANTHROPIC_API_KEY=

# Optional — enable HMAC signing/verification of A2A requests between the
# orchestrator and the 5 agents. If unset, auth is skipped entirely (dev
# default). Set A2A_AUTH_REQUIRED=true to make a missing secret a hard
# startup failure instead of a silent skip.
A2A_SHARED_SECRET=
A2A_AUTH_REQUIRED=false

# Optional — enables audit-log persistence to Postgres. If unset, audit
# logging degrades to a no-op (a warning is printed, nothing else happens).
DATABASE_URL=

# Required for the Compliance Agent (policy RAG over pgvector + Voyage AI
# embeddings). Unlike the other optional vars above, this does NOT degrade to
# a no-op — the Compliance Agent fails to start without it, since silently
# skipping a compliance check would be dangerous. Also requires DATABASE_URL
# and a Postgres instance with the `vector` extension available.
VOYAGE_API_KEY=

# Unused by the current pipeline (RSS feeds require no key); kept for the
# planned Model phase 2 (Gemini Flash for NewsSentiment, see CLAUDE.md roadmap).
SERPER_API_KEY=

# Optional — override the URLs the orchestrator/gateway use to reach each
# agent. Only needed in containerized environments (docker-compose sets
# these to the services' Docker hostnames); defaults are http://localhost:PORT,
# unchanged for local start.sh/uv run usage.
# DATA_COLLECTOR_URL=http://data-collector:8001
# NEWS_SENTIMENT_URL=http://news-sentiment:8002
# FUNDAMENTAL_ANALYST_URL=http://fundamental-analyst:8003
# RISK_ASSESSOR_URL=http://risk-assessor:8004
# REPORT_WRITER_URL=http://report-writer:8005
# COMPLIANCE_AGENT_URL=http://compliance-agent:8006
# PORTFOLIO_MANAGER_URL=http://portfolio-manager:8007

# Example DATABASE_URL for the Docker "full" profile (Postgres + pgvector):
# DATABASE_URL=postgresql://equity:equity@postgres:5432/equity_researcher

# Optional — gateway rate limiting on POST /api/chat (the endpoint that
# triggers paid LLM calls). Defaults below are already applied in code;
# uncomment only to override.
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_MAX_CONCURRENT_RUNS=3
