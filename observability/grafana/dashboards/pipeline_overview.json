{
  "title": "Equity Researcher — Pipeline Overview",
  "uid": "equity-pipeline-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Latenza media per agente (a2a_response)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres_ds" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres_ds" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(created_at, '$__interval') AS time, agent, avg(duration_ms) AS avg_ms FROM audit_log WHERE event_type = 'a2a_response' AND $__timeFilter(created_at) GROUP BY 1, agent ORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Errori per agente (a2a_response, status != completed/ok)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres_ds" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres_ds" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(created_at, '$__interval') AS time, agent, count(*) FILTER (WHERE status NOT IN ('completed', 'ok')) AS errors FROM audit_log WHERE event_type = 'a2a_response' AND $__timeFilter(created_at) GROUP BY 1, agent ORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Costo LLM stimato per giorno ($)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "postgres_ds" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres_ds" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(created_at, '1d') AS time, sum((payload->>'estimated_cost_usd')::numeric) AS cost_usd FROM audit_log WHERE event_type = 'llm_usage' AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Token consumati per agente (periodo selezionato)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "postgres", "uid": "postgres_ds" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres_ds" },
          "format": "table",
          "rawSql": "SELECT agent, sum((payload->>'input_tokens')::numeric) AS input_tokens, sum((payload->>'output_tokens')::numeric) AS output_tokens FROM audit_log WHERE event_type = 'llm_usage' AND $__timeFilter(created_at) GROUP BY agent ORDER BY agent",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Volume chiamate A2A per agente",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "postgres", "uid": "postgres_ds" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres_ds" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(created_at, '$__interval') AS time, agent, count(*) AS calls FROM audit_log WHERE event_type = 'a2a_request' AND $__timeFilter(created_at) GROUP BY 1, agent ORDER BY 1",
          "refId": "A"
        }
      ]
    }
  ]
}
